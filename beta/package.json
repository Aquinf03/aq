{
  "name": "aquin-beta",
  "version": "0.1.0",
  "private": true,
  "description": "Aquin desktop workspace — Electron control plane + AsyncSSH to user machines",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "prebuild": "node scripts/sync-framework-content.mjs",
    "dev": "electron .",
    "start": "electron .",
    "desktop": "electron .",
    "build": "vite build",
    "build:api": "next build",
    "lint": "eslint",
    "backfill:usernames": "tsx --env-file=.env scripts/backfill-usernames.ts",
    "ui:dev": "vite --port 3000 --host localhost",
    "ui:preview": "vite preview --port 3000 --host localhost",
    "api:dev": "next dev --hostname localhost --port 3001"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.112.4",
    "avvvatars-react": "^0.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "openai": "^6.49.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.8.2",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "qs": "^6.16.0"
  }
}
